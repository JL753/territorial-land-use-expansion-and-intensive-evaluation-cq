# Copy to .env for local container deployment. Never commit real secrets.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
# Optional trusted, checksummed research feed and local model.
CQ_RESEARCH_FEED_URL=
CQ_OLLAMA_MODEL=
