# Copy to .env for local container deployment. Never commit real secrets.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_TRUST_PROXY=0

# Optional local AI assistant. Start Ollama and pull a model before enabling.
CQ_OLLAMA_MODEL=
CQ_OLLAMA_BASE_URL=http://127.0.0.1:11434
